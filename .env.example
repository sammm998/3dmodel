# ---- Storage -------------------------------------------------------------
# PostgreSQL connection string. When unset, projects are stored as JSON files
# in ./data (zero-config local mode). Tables are created automatically.
# DATABASE_URL=postgresql://studio:studio@localhost:5432/ai3dstudio   # local only — never use localhost on Railway
# Where uploaded drawings and other binary assets are stored (local object storage).
# OBJECT_STORAGE_DIR=./data/objects
# DATA_DIR=./data

# ---- AI provider -------------------------------------------------------------
# Leave all keys empty to run with the built-in (rule-based) interpreter only.
# AI_PROVIDER=openai            # openai | anthropic | none (auto-detected from keys)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible endpoint
# OPENAI_MODEL=gpt-4.1
# OPENAI_VISION_MODEL=gpt-4.1
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# AI_TIMEOUT_MS=90000

# ---- Site & accounts ----------------------------------------------------------
# Public URL (used for Stripe redirects and social previews). Derived from the
# request when unset.
# APP_URL=https://your-app.up.railway.app
# Shown in the footer and legal pages.
# COMPANY_NAME=Your Company AB
# CONTACT_EMAIL=hello@example.com
# Comma-separated emails that always get the Studio plan (owner/admin accounts).
# ADMIN_EMAILS=you@example.com

# ---- Payments (Stripe) ----------------------------------------------------------
# Without these the pricing page still works, but upgrades are disabled.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# One recurring Price per paid plan and interval (Stripe Dashboard → Products):
# STRIPE_PRICE_PRO_MONTHLY=price_...
# STRIPE_PRICE_PRO_YEARLY=price_...
# STRIPE_PRICE_STUDIO_MONTHLY=price_...
# STRIPE_PRICE_STUDIO_YEARLY=price_...
